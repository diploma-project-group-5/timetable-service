# Скопіюйте у .env: cp .env.example .env
# Значення за замовчуванням — для локальної розробки проти стенду platform (make up там).

PORT=3003
LOG_LEVEL=info

# База timetable на сервері PostgreSQL зі стенду platform. Ролі й паролі створює platform/db-init
# (паролі — змінні TIMETABLE_*_DB_PASSWORD у .env репозиторію platform).
DATABASE_URL=postgres://timetable_app:local-timetable-app-pass@localhost:5432/timetable
# Relay outbox → Kafka: бачить лише outbox.
RELAY_DATABASE_URL=postgres://timetable_relay:local-timetable-relay-pass@localhost:5432/timetable
# Сторож задач і щоденна чистка outbox та inbox.
MAINT_DATABASE_URL=postgres://timetable_maint:local-timetable-maint-pass@localhost:5432/timetable
# Власник таблиць — лише для make migrate.
MIGRATION_DATABASE_URL=postgres://timetable_owner:local-timetable-owner-pass@localhost:5432/timetable

# Перевірка JWT: iss — публічна адреса Keycloak (як у браузері), ключі — звідки сервіс їх може взяти.
OIDC_ISSUER=http://localhost/idp/realms/lad
OIDC_JWKS_URL=http://localhost/idp/realms/lad/protocol/openid-connect/certs

# Знімок даних закладу: внутрішній порт school-service (у compose — http://school-service:3102).
SCHOOL_INTERNAL_URL=http://localhost:3102

# Секрет HMAC для QR (розділ 11): мінімум 32 символи, лише в .env, не в git.
# Зміна секрету робить недійсними всі QR усіх закладів — лише при витоку, з повторним друком.
# Новий: openssl rand -base64 48
QR_HMAC_SECRET=local-dev-only-qr-secret-change-me-0123456789
# Публічна адреса для посилань QR (як LAD_PUBLIC_URL у platform).
PUBLIC_URL=http://localhost

# Kafka зі стенду platform: з хоста — localhost:29092, з контейнера compose — kafka:9092.
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=timetable-service
KAFKA_GROUP_ID=timetable-service

# Параметри предметної логіки (значення за замовчуванням — зі специфікації й contracts).
# BUILD_TIME_LIMIT_S=60
# SUBSTITUTION_TIME_LIMIT_S=30
# QUEUE_ALLOWANCE_S=600
# RUN_DEADLINE_MARGIN_S=90
# PUBLISH_MIN_DAYS=7
# ALERT_THRESHOLD_MINUTES=120
# ALERT_THRESHOLD_DAYS=3
# PRIORITY_AREAS=math,science,language_literature,civic_history
